{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/frontend-app/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://negocode.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://negocode.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}
